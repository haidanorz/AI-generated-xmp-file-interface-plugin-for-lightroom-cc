<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="AI Color Generator 1.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:crs="http://ns.adobe.com/camera-raw-settings/1.0/"
    crs:Version="17.5"
    crs:ProcessVersion="15.4"
    crs:RawFileName="IMG_1023.CR3"
    crs:AIColorSchema="1.0"
    crs:WhiteBalance="As Shot"
  >

   <!-- 点曲线：XMP 写法是 "x, y" 字符串序列 -->
   <crs:ToneCurveName2012>Custom</crs:ToneCurveName2012>
   <crs:ToneCurvePV2012>
    <rdf:Seq>
     <rdf:li>0, 0</rdf:li>
     <rdf:li>92, 106</rdf:li>
     <rdf:li>255, 255</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012>

   <!-- 恒等（线性）曲线：应当被跳过，不写入也不强制 Custom -->
   <crs:ToneCurvePV2012Red>
    <rdf:Seq>
     <rdf:li>0, 0</rdf:li>
     <rdf:li>255, 255</rdf:li>
    </rdf:Seq>
   </crs:ToneCurvePV2012Red>

   <!-- 参数化曲线 -->
   <crs:ParametricShadows>-10</crs:ParametricShadows>
   <crs:ParametricDarks>-5</crs:ParametricDarks>
   <crs:ParametricLights>+8</crs:ParametricLights>
   <crs:ParametricHighlights>-12</crs:ParametricHighlights>
   <crs:ParametricShadowSplit>25</crs:ParametricShadowSplit>
   <crs:ParametricMidtoneSplit>50</crs:ParametricMidtoneSplit>
   <crs:ParametricHighlightSplit>75</crs:ParametricHighlightSplit>

   <!-- 颜色分级：高光轮用 SDK 规范键名 -->
   <crs:SplitToningHighlightHue>48</crs:SplitToningHighlightHue>
   <crs:SplitToningHighlightSaturation>12</crs:SplitToningHighlightSaturation>

   <!-- 颜色分级：阴影轮用「看起来一致但其实不存在」的别名键名，必须被转换 -->
   <crs:ColorGradeShadowHue>211</crs:ColorGradeShadowHue>
   <crs:ColorGradeShadowSat>9</crs:ColorGradeShadowSat>

   <crs:ColorGradeBlending>50</crs:ColorGradeBlending>
   <crs:SplitToningBalance>+10</crs:SplitToningBalance>

   <!-- 应当被明确标记为不支持 -->
   <crs:Look>
    <rdf:Description rdf:about="" crs:Name="Adobe Color"/>
   </crs:Look>
   <crs:RetouchInfo>
    <rdf:Seq>
     <rdf:li></rdf:li>
    </rdf:Seq>
   </crs:RetouchInfo>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
